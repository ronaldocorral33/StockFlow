Options -Indexes

# El .env vive en la raíz del proyecto, que Apache sirve. Sin esta regla, cualquiera
# podría pedir http://.../.env y descargar todas las credenciales en texto plano.
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
