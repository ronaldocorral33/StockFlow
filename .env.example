# Plantilla de credenciales. Copia este archivo a .env y llena tus valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.
#
# En producción, define estas mismas claves como variables de entorno del servidor
# y borra el .env — Env::get() siempre prefiere la variable de entorno real.

# --- Base de datos principal ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=control_inventario
DB_USER=root
DB_PASS=

# --- Usuario de solo lectura que usa el chatbot (ver sql/chatbot_ro_user.sql) ---
DB_CHATBOT_USER=chatbot_ro
DB_CHATBOT_PASS=CAMBIA-ESTA-CONTRASEÑA

# --- Proveedor de IA: 'azure_openai', 'anthropic' o 'auto' ---
LLM_PROVIDER=auto

# Azure OpenAI (endpoint compatible con la API de OpenAI, terminado en /openai/v1)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Anthropic (alternativa a Azure)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
