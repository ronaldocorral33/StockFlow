# Secretos reales (API keys, contraseñas) — nunca subir. Usa .env.example como plantilla.
.env
# config.php ya no contiene secretos (lee de .env), pero se mantiene ignorado
# por compatibilidad con instalaciones anteriores que sí los tenían embebidos.
config/config.php

# Datos de negocio reales / archivos personales, no código del proyecto.
*.xlsx
*.xls
control_jerseys*.html
/backups/

# Artefactos del entorno / runtime, no forman parte del código.
.claude/
nul

# Comunes de PHP/editor/SO.
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
